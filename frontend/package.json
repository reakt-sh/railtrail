{
    "name": "frontend",
    "version": "0.2.0",
    "scripts": {
        "build": "ng build",
        "debug-build": "ng build --configuration development",
        "watch": "ng build --watch --configuration development",
        "serve": "ng serve --configuration development",
        "test": "ng test",
        "sme": "ng build --source-map=true --named-chunks==true && source-map-explorer dist/frontend/**/*.js",
        "capacitor:sync:after": "rsync -ph --copy-links --ignore-errors --progress ./runtime-environment.mobile.js ./android/app/src/main/assets/public/runtime-environment.js",
        "lint": "ng lint"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.2.6",
        "@angular/cdk": "^22.3.0",
        "@angular/common": "^22.2.6",
        "@angular/compiler": "^22.2.6",
        "@angular/core": "^22.2.6",
        "@angular/forms": "^22.2.6",
        "@angular/material": "^22.3.0",
        "@angular/platform-browser": "^22.2.6",
        "@angular/platform-browser-dynamic": "^22.2.6",
        "@angular/router": "^22.2.6",
        "@capacitor/android": "^8.2.0",
        "@capacitor/angular": "^2.0.3",
        "@capacitor/core": "^8.2.0",
        "@capacitor/ios": "^8.2.0",
        "@maplibre/ngx-maplibre-gl": "^22.3.1",
        "@turf/turf": "^7.4.0",
        "loglevel": "^1.9.2",
        "maplibre-gl": "^6.19.0",
        "rxjs": "~7.8.2",
        "tslib": "^2.3.0",
        "zone.js": "^0.16.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.7",
        "@angular/cli": "^22.2.7",
        "@angular/compiler-cli": "^22.2.6",
        "@angular/localize": "^22.2.6",
        "@capacitor/cli": "^8.2.0",
        "@eslint/js": "^10.0.1",
        "@types/eslint__js": "^8.42.3",
        "@types/jasmine": "~5.1.13",
        "angular-eslint": "^22.8.0",
        "eslint": "^10.15.0",
        "istanbul-lib-instrument": "^6.0.3",
        "jasmine-core": "~5.13.0",
        "json-schema-to-typescript": "^16.0.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "source-map-explorer": "^2.5.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
